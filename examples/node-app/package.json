{
  "name": "node-app",
  "private": true,
  "version": "0.0.0",
  "description": "Minimal Express service demonstrating @nebula-ops/otel-node end-to-end — auto-instrumentation, manual spans, and trace-correlated pino logs.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --import ./src/instrumentation.ts ./src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nebula-ops/otel-core": "workspace:*",
    "@nebula-ops/otel-node": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
